# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec.bak

# Virtual environments
.venv/
venv/
env/

# Test / coverage caches
.pytest_cache/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# Secrets / local environment (never commit)
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Recorded media (never commit camera recordings)
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm
*.mpg
*.m4v

# Logs produced at runtime
*.log

# MediaPipe model (downloaded once by scripts/download_model.py)
# Keep it out of version control; each user downloads it during setup.
assets/models/*.task
